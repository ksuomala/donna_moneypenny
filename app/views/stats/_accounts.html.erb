<section class="stats-section">
  <h2>Accounts <span class="muted"><%= money(total) %></span></h2>

  <% if rows.empty? %>
    <p class="muted">No accounts.</p>
  <% else %>
    <div class="ledger-scroll">
      <table class="ledger accounts">
        <thead>
          <tr>
            <th scope="col">Account</th>
            <th scope="col" class="number">Balance</th>
            <th scope="col" class="number">Change</th>
          </tr>
        </thead>
        <tbody>
          <% rows.each do |row| %>
            <tr>
              <th scope="row"><%= row.name %></th>
              <td class="number"><%= row.balance ? money(row.balance) : tag.span("unknown", class: "muted") %></td>
              <td class="number"><%= row.change ? signed_money(row.change) : tag.span("–", class: "muted") %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <th scope="row">Total</th>
            <td class="number"><%= money(total) %></td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    </div>
    <p class="muted ledger-note">Balance as the bank last reported it on or before the end of the period. Credit cards are listed with the loans.</p>
  <% end %>
</section>
