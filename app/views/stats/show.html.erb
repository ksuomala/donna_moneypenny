<% content_for :title, "Stats · Donna Moneypenny" %>

<main class="page stats">
  <nav class="page-nav"><%= link_to "Bank connections", root_path %><%= button_to "Sign out", session_path, method: :delete, class: "link-button", form_class: "button-to" %></nav>

  <h1>Stats</h1>
  <p class="muted stats-period"><%= stats_period_label(@range) %></p>

  <nav class="month-tabs" aria-label="Months" data-controller="scroll-to-current">
    <% @months.each do |month| %>
      <% active = @range == month.all_month %>
      <%= link_to l(month, format: "%b %y"), stats_path(month: month.strftime("%Y-%m")), class: [ "month-tab", { "month-tab-active": active } ], aria: { current: (active ? "true" : nil) } %>
    <% end %>
  </nav>

  <div class="stats-filters">
    <div class="quick-filters period-filters">
      <% { "week" => "This week", "month" => "This month", "year" => "This year" }.each do |period, label| %>
        <%= link_to label, stats_path(period: period), class: [ "chip", { "chip-active": @period == period } ], aria: { current: (@period == period ? "true" : nil) } %>
      <% end %>
    </div>

    <% if @members.many? %>
      <div class="quick-filters scope-filter" aria-label="Whose">
        <% { "me" => "Me", "household" => Current.user.household.name }.each do |scope, label| %>
          <%= link_to label, stats_path(request.query_parameters.merge(scope: scope)), class: [ "chip", { "chip-active": @scope == scope } ], aria: { current: (@scope == scope ? "true" : nil) } %>
        <% end %>
        <% if @scope == "household" && @stats.internal_transfers.positive? %>
          <span class="muted rate-note">between members, left out: <%= money(@stats.internal_transfers) %></span>
        <% end %>
      </div>
    <% end %>

    <div class="quick-filters currency-filter" aria-label="Currency">
      <% DisplayCurrency::CODES.each do |code| %>
        <%= link_to code, stats_path(request.query_parameters.merge(currency: code)), class: [ "chip", { "chip-active": @currency.code == code } ], aria: { current: (@currency.code == code ? "true" : nil) } %>
      <% end %>
      <% unless @currency.euros? %>
        <span class="muted rate-note">1 € = <%= number_with_precision(@currency.rate, precision: 4, separator: ",") %> <%= @currency.unit %> (ECB, <%= l @currency.on, format: :long %>)</span>
      <% end %>
    </div>

    <%= form_with url: stats_path, method: :get, class: "timeline-filter" do |form| %>
      <span class="field"><%= form.label :from, "From" %> <%= form.date_field :from, value: @range.begin %></span>
      <span class="field"><%= form.label :to, "To" %> <%= form.date_field :to, value: @range.end %></span>
      <%= form.submit "Show", name: nil, class: "button" %>
    <% end %>
  </div>

  <div class="stat-tiles">
    <div class="stat-tile">
      <span class="muted">Income</span>
      <strong><%= money(@stats.income_total) %></strong>
    </div>
    <div class="stat-tile">
      <span class="muted">Expenses</span>
      <strong><%= money(@stats.expense_total) %></strong>
    </div>
    <div class="stat-tile">
      <span class="muted">Net</span>
      <strong><%= money(@stats.net) %></strong>
    </div>
  </div>

  <div data-controller="tabs" data-tabs-storage-key-value="stats-chart">
    <div class="tabs" role="tablist">
      <button type="button" role="tab" class="tab" data-tabs-target="tab" data-tab="bar" data-action="tabs#select">Bar chart</button>
      <button type="button" role="tab" class="tab" data-tabs-target="tab" data-tab="pie" data-action="tabs#select">Pie chart</button>
    </div>

    <div role="tabpanel" data-tabs-target="panel" data-tab="bar">
      <%= render "bars", title: "Income", slices: @stats.incomes, total: @stats.income_total %>
      <%= render "bars", title: "Expenses", slices: @stats.expenses, total: @stats.expense_total %>
    </div>

    <div role="tabpanel" data-tabs-target="panel" data-tab="pie" hidden>
      <div class="pies">
        <%= render "pie", title: "Income", slices: @stats.incomes, total: @stats.income_total %>
        <%= render "pie", title: "Expenses", slices: @stats.expenses, total: @stats.expense_total %>
      </div>
    </div>
  </div>

  <%= render "accounts", rows: @stats.accounts, total: @stats.account_total %>
  <%= render "loans", rows: @stats.loans, total: @stats.loan_total, taken: @stats.loans_taken, paid: @stats.loans_paid %>
</main>
